# Copy to .env and fill in. .env is gitignored; this file is not.
META_API_KEY=

# Edge -> backend signing. Empty means "demo mode, no signature check".
EDGE_TOKEN=

# Household
HOUSEHOLD_TZ=Africa/Cairo
MEDIA_ROOT=data/media

# Dashboard access. Empty HOUSEHOLD_PIN leaves the demo open on localhost;
# set it and every clip needs a session cookie or a signed link. SESSION_SECRET
# signs both, so rotating it revokes every phone at once.
HOUSEHOLD_PIN=
SESSION_SECRET=
COOKIE_SECURE=0
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# AEGIS_WORKER=off keeps the enrichment and escalation loops out of the API
# process, for `python scripts/worker.py`. See plan §8.5.
AEGIS_WORKER=on

# Web Push (VAPID). Generate once:
#   python -c "import base64;from cryptography.hazmat.primitives.asymmetric import ec;\
#   k=ec.generate_private_key(ec.SECP256R1());print(base64.urlsafe_b64encode(\
#   k.public_key().public_numbers().x.to_bytes(32,'big')+\
#   k.public_key().public_numbers().y.to_bytes(32,'big')).decode().rstrip('='))"
# and point VAPID_PRIVATE_KEY at the PEM file. Both are gitignored.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=config/vapid.pem
VAPID_SUBJECT=mailto:care@aegis.local
