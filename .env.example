# `python run.py setup` creates .env from this file without replacing an existing one.
# For the full demo, add a Meta Model API key with access to SAM 3.1, Muse Spark
# and Muse Voice Transcribe. Everything else below is optional for localhost.
# Without a key, local camera mapping, detection and tests still work.
META_API_KEY=

# Edge -> backend signing. Empty means "demo mode, no signature check".
EDGE_TOKEN=

# Household
HOUSEHOLD_TZ=Africa/Cairo
MEDIA_ROOT=data/media

# `python run.py demo` downloads six public URFD clips here for the lab picker.
FOOTAGE_ROOT=data/new-footage

# Dashboard access. Empty HOUSEHOLD_PIN leaves the demo open on localhost;
# set it and every household API needs a session cookie, the web app shows a
# PIN screen, and every clip needs that session or a five-minute signed link.
# SESSION_SECRET signs both, so rotating it revokes every phone at once.
HOUSEHOLD_PIN=
SESSION_SECRET=
COOKIE_SECURE=0
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# AEGIS_WORKER=off keeps the enrichment and escalation loops out of the API
# process, for `python scripts/worker.py`. The default runner needs no extra worker.
AEGIS_WORKER=on

# Optional stronger detector for the lost-person recheck (place the weights in
# the repo root). Measured on the 110-clip corpus: equal floor-fall recall
# (49/57) but one extra ADL family alert versus the default fast model at
# 448px. Leave empty for the measured-best default.
# AEGIS_RECHECK_MODEL=yolov8m.pt

# Spoken check-in. The question is rendered locally by the machine that owns
# the media, so it works when the uplink is down. CHECKIN_TTS=off leaves the
# dashboard's browser voice as the fallback.
CHECKIN_TIMEOUT_S=15
CHECKIN_TTS=on
# CHECKIN_TTS_VOICE=Microsoft Zira Desktop

# Audio-distress pre-filter. Heuristic, not a medical classifier.
AUDIO_LOUD_DBFS=-20
AUDIO_SCREAM_DBFS=-15
AUDIO_SCREAM_LOUD_RATIO=0.30

# Backup delivery: signed alert text to endpoints your household trusts
# (caregiver automation, nurse-call bridge). No media is sent.
# FAMILY_WEBHOOK_URL=https://caregiver.example.test/aegis
# FAMILY_BACKUP_WEBHOOK_URL=https://backup.example.test/aegis
# FAMILY_WEBHOOK_SECRET=change-me

# Built-in SMS (Twilio REST, no SDK). Comma-separated primary and backup numbers.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550000000
# FAMILY_SMS_TO=+15551110000,+15552220000
# PUBLIC_BASE_URL=https://aegis.example.test

# Optional Web Push (VAPID): supply a matching P-256 key pair. The public value
# is the base64url-encoded, uncompressed public key (including the 0x04 prefix).
# VAPID_PRIVATE_KEY points to the private PEM. The .env and PEM stay gitignored.
# In-app delivery works without these keys; see docs/SETUP.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=config/vapid.pem
VAPID_SUBJECT=mailto:care@aegis.local
